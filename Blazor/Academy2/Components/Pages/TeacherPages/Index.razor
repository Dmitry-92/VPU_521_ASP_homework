@page "/teachers"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@using Academy2.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Academy2.Data.Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>
<div class="controls">
<h1>Преподаватели</h1>

<p>
    <a href="teachers/create" class="btn btn-primary">Добавить</a>
</p>
</div>

<QuickGrid Class="table" Items="context.Teachers">
   
    @*<PropertyColumn Property="teacher => teacher.TDR" />*@
    <TemplateColumn Context="teacher" Title="Преподаватель">
        <a href="@($"/teachers/details?teacher_id={teacher.teacher_id}")">@teacher.full_name</a>
    </TemplateColumn>
    <PropertyColumn Property="teacher => teacher.birth_date" />
    @*<PropertyColumn Property="teacher => teacher.last_name" />
    <PropertyColumn Property="teacher => teacher.first_name" />
    <PropertyColumn Property="teacher => teacher.middle_name" />
    <PropertyColumn Property="teacher => teacher.birth_date" />
    <PropertyColumn Property="teacher => teacher.email" />
    <PropertyColumn Property="teacher => teacher.phone" />
    <PropertyColumn Property="teacher => teacher.photo" />
    <PropertyColumn Property="teacher => teacher.full_name" />*@
    <PropertyColumn Property="teacher => teacher.work_since" />
    <PropertyColumn Property="teacher => teacher.rate" />
    @* <TemplateColumn Context="teacher">
        <a href="@($"teachers/edit?teacher_id={teacher.teacher_id}")">Edit</a> |
        <a href="@($"teachers/details?teacher_id={teacher.teacher_id}")">Details</a> |
        <a href="@($"teachers/delete?teacher_id={teacher.teacher_id}")">Delete</a>
    </TemplateColumn>*@
</QuickGrid>

@code {
    private Academy2Context context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}

@page "/groups/edit"
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2.Data.Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

@if (Group is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>@Group.GroupName</h1>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Group" OnValidSubmit="UpdateGroup" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Group.GroupId" value="@Group.GroupId" />
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="GroupName" class="form-label">GroupName:</label>
                    <InputText id="GroupName" @bind-Value="Group.GroupName" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Group.GroupName" class="text-danger" />
                </div>
                @*<div class="mb-3">
                    <label for="direction" class="form-label">direction:</label>
                    <InputSelect id="direction" @bind-Value="Group.direction" class="form-control">
                        @using (Academy2.Data.Academy2Context context_ = DbFactory.CreateDbContext())
                    {
                        @foreach (ChooseDirection direction in context_.Directions)
                        {
                            <option value="@direction.DirectionId">@direction.DirectionName</option>
                        }
                    }
                    </InputSelect>
                    <ValidationMessage For="() => Group.direction" class="text-danger" />
                </div>*@
                <ChooseDirection Group="Group"/>
                <div class="mb-3">
                    <label for="Weekdays" class="form-label">Weekdays:</label>
                    <input type="number" id="Weekdays" value="@Group.Weekdays" @onchange="OnWeekdaysChanged" class="form-control" />
                    <ValidationMessage For="() => Group.Weekdays" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="StartTime" class="form-label">StartTime:</label>
                    <InputDate Type="InputDateType.Time" id="StartTime" @bind-value="Group.StartTime" class="form-control" />
                    <ValidationMessage For="() => Group.StartTime" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/groups">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int GroupId { get; set; }

    [SupplyParameterFromForm]
    private Group? Group { get; set; }
    
    private void OnDirectionChanged(ChangeEventArgs e)
    {
        if (byte.TryParse(e.Value?.ToString(), out var b))
            Group!.direction = b;
        else
            Group!.direction = null;
    }

    private void OnWeekdaysChanged(ChangeEventArgs e)
    {
        if (byte.TryParse(e.Value?.ToString(), out var b))
            Group!.Weekdays = b;
        else
            Group!.Weekdays = null;
    }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Group ??= await context.Groups.FirstOrDefaultAsync(m => m.GroupId == GroupId);

        if (Group is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        if (TimeOnly.TryParse(e.Value?.ToString(), out var ts))
            Group!.StartTime = ts;
        else
            Group!.StartTime = null;
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateGroup()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Group!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!GroupExists(Group!.GroupId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/groups");
    }

    private bool GroupExists(int GroupId)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Groups.Any(e => e.GroupId == GroupId);
    }
}

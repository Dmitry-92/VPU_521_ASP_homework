@using Academy2.Models;

<h6>Learning days</h6>

<ul class="learning-days form-control">
    @for (int i = 0; i < 7; i++)
    {
        int index = i;
        <li>
            <input type="checkbox" id="@Week.DAYNAMES[i]" @bind="days[index]" @bind:after="Compress" />
            <label for="@Week.DAYNAMES[i]">@Week.DAYNAMES[i]</label>
        </li>
    }
</ul>

@code
{
    [Parameter]
    public Group Group { get; set; }
    bool[] days = new bool[7];

    void Compress()
    {
        int mask = 0;
        for (int i = 0; i < 7; i++)
        {
            if (days[i]) mask |= (1 << i);
        }
        Group.learning_days = mask;
    }
    void Extract()
    {
        if(Group.learning_days != null)
            for (int i = 0; i < 7; i++)
            {
                if (((Group.learning_days >> i) & 1) != 0) days[i] = true;
            }
    }

    protected override void OnInitialized()
    {
        Extract();
    }
}
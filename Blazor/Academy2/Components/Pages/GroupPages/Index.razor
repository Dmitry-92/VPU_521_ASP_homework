@page "/groups"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy2.Models
@using Academy2.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Academy2.Data.Academy2Context> DbFactory

<PageTitle>Index</PageTitle>

<div class="controls">
    <h1>Группы</h1>

    <p>
        <a href="groups/create" class="btn btn-primary">Добавить</a>
    </p>
</div>

<QuickGrid Class="table" Items="context.Groups.Include(g => g.Direction)">
    <PropertyColumn Property="group => group.group_name" />
    <PropertyColumn Property="group => group.Direction.direction_name" />
    <PropertyColumn Property="group => new Week((int)(group.learning_days ?? 0))" />
    <PropertyColumn Property="group => group.start_time" />
    <PropertyColumn Property="group => group.start_date" />

    <TemplateColumn Context="group">
        <a href="@($"groups/details?group_id={group.group_id}")">Details</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private Academy2Context context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
@page "/groups/create"
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2.Data.Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Group</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Group" OnValidSubmit="AddGroup" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="GroupName" class="form-label">GroupName:</label> 
                <InputText id="GroupName" @bind-Value="Group.GroupName" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Group.GroupName" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="direction" class="form-label">direction:</label>
                <input type="number" id="direction" value="@Group.direction" @onchange="OnDirectionChanged" class="form-control" />
                <ValidationMessage For="() => Group.direction" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="Weekdays" class="form-label">Weekdays:</label>
                <input type="number" id="Weekdays" value="@Group.Weekdays" @onchange="OnWeekdaysChanged" class="form-control" />
                <ValidationMessage For="() => Group.Weekdays" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="StartTime" class="form-label">StartTime:</label> 
                <input type="time" id="StartTime" value="@Group.StartTime" @onchange="OnStartTimeChanged" class="form-control" /> 
                <ValidationMessage For="() => Group.StartTime" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/groups">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Group Group { get; set; } = default!;

    protected override void OnInitialized() => Group ??= new();
    
    private void OnDirectionChanged(ChangeEventArgs e)
    {
        if (byte.TryParse(e.Value?.ToString(), out var b))
            Group!.direction = b;
        else
            Group!.direction = null;
    }

    private void OnWeekdaysChanged(ChangeEventArgs e)
    {
        if (byte.TryParse(e.Value?.ToString(), out var b))
            Group!.Weekdays = b;
        else
            Group!.Weekdays = null;
    }
    
    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        if (TimeOnly.TryParse(e.Value?.ToString(), out var ts))
            Group.StartTime = ts;
        else
            Group.StartTime = null;
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddGroup()
    {
        using var context = DbFactory.CreateDbContext();
        context.Groups.Add(Group);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/groups");
    }
}

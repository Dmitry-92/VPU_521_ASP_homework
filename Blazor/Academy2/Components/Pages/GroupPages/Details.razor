@page "/groups/details"
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2.Data.Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>


<div>
    @*  <h2>Group</h2>
    <hr /> *@
    @if (group is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="controls">
            <h1>@group.group_name</h1>
            <a href="@($"/groups/edit?group_id={group.group_id}")" class="btn btn-primary">Edit</a>
        </div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">group_name</dt>			<dd class="col-sm-10">@group.group_name</dd>
            <dt class="col-sm-2">direction</dt>				<dd class="col-sm-10">@group.direction</dd>
            <dt class="col-sm-2">learning_days</dt>			<dd class="col-sm-10">@(new Week((int)(group.learning_days ?? 0)))</dd>
            <dt class="col-sm-2">start_time</dt>			<dd class="col-sm-10">@group.start_time</dd>
            <dt class="col-sm-2">start_date</dt>			<dd class="col-sm-10">@group.start_date</dd>
        </dl>
        <h3>Студенты</h3>
        @if (group.Students != null && group.Students.Any())
        {
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>ФИО</th>
                    <th>Дата рождения</th>
                    <th>Email</th>
                    <th>Телефон</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var student in group.Students)
                {
                    <tr>
                        <td>@student.full_name</td>
                        <td>@student.birth_date.ToShortDateString()</td>
                        <td>@student.email</td>
                        <td>@student.phone</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p><em>В этой группе пока нет студентов.</em></p>
        }
        <div>
            <a href="@($"/groups")">Back to List</a>
        </div>
    }
</div>

@code {
    private Group? group;

    [SupplyParameterFromQuery] private int group_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        group = await context.Groups
            .Include(g => g.Students)
            .FirstOrDefaultAsync(m => m.group_id == group_id);

        if (group is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}    
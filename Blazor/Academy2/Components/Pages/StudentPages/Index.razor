@page "/students"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy2.Models
@using Academy2.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Academy2.Data.Academy2Context> DbFactory

<PageTitle>Index</PageTitle>

<div class="controls">
	<h1>Студенты</h1>

	<p>
		<a href="students/create" class="btn btn-primary">Добавить</a>
	</p>
</div>

<div class="mb-3">
	<input type="text" class="form-control" placeholder="Поиск по фамилии студента..." @bind="searchString" @bind:event="oninput" />
</div>

<QuickGrid Class="table" Items="FilteredStudents.Include(s => s.Group).ThenInclude(g => g.Direction)">
	@*  <PropertyColumn Property="student => student.last_name" />
    <PropertyColumn Property="student => student.first_name" />
    <PropertyColumn Property="student => student.middle_name" /> *@
	@* <PropertyColumn Property="student => student.full_name" /> *@
	<TemplateColumn Context="student"
					Title="Студент"
					Sortable="true"
					SortBy="sortBy"
					>
		<a href="@($"students/details?stud_id={student.stud_id}")">@student.full_name</a>
	</TemplateColumn>
	<PropertyColumn Property="student => student.birth_date"			Sortable="true"/>
	<PropertyColumn Property="student => student.Group.group_name"		Sortable="true"/>
	<PropertyColumn Property="student => student.Group.Direction.direction_name" />
	@*     <PropertyColumn Property="student => student.email" />
    <PropertyColumn Property="student => student.phone" />
    <PropertyColumn Property="student => student.photo" /> *@

	@* <TemplateColumn Context="student">
        <a href="@($"students/edit?stud_id={student.stud_id}")">Edit</a> |
        <a href="@($"students/details?stud_id={student.stud_id}")">Details</a> |
        <a href="@($"students/delete?stud_id={student.stud_id}")">Delete</a>
    </TemplateColumn> *@
	<Paginator State="pagination" />
</QuickGrid>

@code
{
	private Academy2Context context = default!;
	private string searchString = "";
	private PaginationState pagination = new() { ItemsPerPage = 5 };

	GridSort<Student> sortBy = GridSort<Student>.ByAscending(s => s.last_name);

	private IQueryable<Student> FilteredStudents =>
		string.IsNullOrWhiteSpace(searchString)
			? context.Students.Include(s => s.Group).ThenInclude(g => g.Direction)
			: context.Students.Include(s => s.Group).ThenInclude(g => g.Direction)
				.Where(s => s.last_name.Contains(searchString));

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
@page "/directions/details"
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IDbContextFactory<Academy2.Data.Academy2Context> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Details</PageTitle>

@*<h1>Details</h1>*@

<div>
    @*<h2>Direction</h2>*@
    <hr />
    @if (direction is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <h1>@direction.direction_name</h1>
        <dl class="row">
            <dt class="col-sm-2">Количество групп </dt>
            <dd class="col-sm-10">@direction.Groups.Count</dd>
        </dl>
        <div>
            <a href="@($"/directions/edit?direction_id={direction.direction_id}")">Edit</a> |
            <a href="@($"/directions")">Back to List</a>
        </div>
        
        <h3>Группы</h3>
        @*<ul>
            @foreach (Group group in direction.Groups)
            {
                <li>@group.group_name</li>
            }
        </ul>*@
        <QuickGrid Items="direction.Groups.AsQueryable()" Class="table">
            <PropertyColumn Sortable="true" Property="group => group.group_name" />
            <PropertyColumn Sortable="true" Property="group => group.start_time" />
            <PropertyColumn Sortable="true" Property="group => group.Students.Count" />
        </QuickGrid>
    }
</div>

@code {
    private Direction? direction;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions.
            Include(d => d.Groups).
            ThenInclude(g => g.Students).
            FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (direction is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}

@page "/disciplines/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2.Data.Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Discipline</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Discipline" OnValidSubmit="AddDiscipline" FormName="create">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="discipline_name" class="form-label">discipline_name:</label> 
                <InputText id="discipline_name" @bind-Value="Discipline.discipline_name" @bind-Value:event="oninput" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Discipline.discipline_name" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="number_of_lessons" class="form-label">number_of_lessons:</label> 
                <InputNumber id="number_of_lessons" @bind-Value="Discipline.number_of_lessons" @bind-Value:event="oninput" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Discipline.number_of_lessons" class="text-danger" /> 
            </div>        
            @*   <div class="mb-3">
                <label for="teachers" class="form-label">Teachers:</label> 
                <InputText id="teachers" @bind-Value="Discipline.Teachers" class="form-control" /> 
                <ValidationMessage For="() => Discipline.Teachers" class="text-danger" /> 
            </div>      *@  
            <EditDisciplineRelations Discipline="Discipline" 
                                     DependentDisciplines="dependentDisciplines" 
                                     RequiredDisciplines="requiredDisciplines" 
                                     OnRelationsChanged="StateHasChanged" />
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/disciplines">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm] private Discipline Discipline { get; set; } = new();
    private List<Discipline> dependentDisciplines = new();
    private List<Discipline> requiredDisciplines = new();

    protected override void OnInitialized() => Discipline ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        context.Disciplines.Add(Discipline);
        await context.SaveChangesAsync();
        
        //Сохраняем зависимые дисциплины
        foreach (var d in dependentDisciplines)
        {
            context.DependentDisciplines.Add(new DependentDiscipline
            {
                discipline = Discipline.discipline_id,
                dependent_discipline = d.discipline_id
            });
        }
        
        //Сохраняем требуемые дисциплины
        foreach (var r in requiredDisciplines)
        {
            context.RequiredDisciplines.Add(new RequiredDiscipline
            {
                discipline = Discipline.discipline_id,
                required_discipline = r.discipline_id
            });
        }
        
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/disciplines");    
        
    }
}    
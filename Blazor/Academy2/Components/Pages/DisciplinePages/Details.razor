@page "/disciplines/details"
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2.Data.Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Discipline</h2>
    <hr />
    @if (discipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        
        <h1>@discipline.discipline_name</h1>
        <a href="@($"/disciplines/edit?discipline_id={discipline.discipline_id}")">Edit</a> 
        <hr />
        <dl class="row">
            <dt class="col-sm-2">discipline_name</dt>
            <dd class="col-sm-10">@discipline.discipline_name</dd>
            <dt class="col-sm-2">number_of_lessons</dt>
            <dd class="col-sm-10">@discipline.number_of_lessons</dd>
            <dt class="col-sm-2">Teachers</dt>
            @* <dd class="col-sm-10">@discipline.Teachers</dd> *@
        </dl>
        <div>
            <h3>Зависимые дисциплины</h3>
            @if (dependentDisciplines != null && dependentDisciplines.Any())
            {
                <ul>
                    @foreach (var d in dependentDisciplines)
                    {
                        <li>@d.discipline_name</li>
                    }
                </ul>
            }
            else
            {
                <p><em>Нет зависимых дисциплин.</em></p>
            }

            <h3>Требуемые дисциплины</h3>
            @if (requiredDisciplines != null && requiredDisciplines.Any())
            {
                <ul>
                    @foreach (var d in requiredDisciplines)
                    {
                        <li>@d.discipline_name</li>
                    }
                </ul>
            }
            else
            {
                <p><em>Нет требуемых дисциплин.</em></p>
            }

            <a href="@($"/disciplines")">Back to List</a>
        </div>
        <h3>Количество преподавателей: @discipline.TDR.Count</h3>
        <ul>
            @foreach (TeachersDisciplinesRelation tdr in discipline.TDR)
            {
                <li>@tdr.Teacher.full_name</li>
            }
        </ul>
    }
</div>

@code {
    private Discipline? discipline;
    private List<Discipline> dependentDisciplines = new();
    private List<Discipline> requiredDisciplines = new();

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Disciplines
            .Include(d => d.TDR)
            .ThenInclude(tdr => tdr.Teacher)
            .FirstOrDefaultAsync(m => m.discipline_id == discipline_id);
        

        if (discipline is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
        // Загружаем зависимые дисциплины
        dependentDisciplines = await context.DependentDisciplines
            .Where(dd => dd.discipline == discipline_id)
            .Select(dd => dd.Dependent)
            .ToListAsync();

        // Загружаем требуемые дисциплины
        requiredDisciplines = await context.RequiredDisciplines
            .Where(rd => rd.discipline == discipline_id)
            .Select(rd => rd.Required)
            .ToListAsync();
    }
}
